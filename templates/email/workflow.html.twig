<!DOCTYPE html>
<html lang="{{ locale }}">
<body style="margin:0;padding:24px;background:#f7f9fc;color:#1b1b1b;font-family:Montserrat,Arial,sans-serif;line-height:1.5">
    <div style="max-width:560px;margin:0 auto;background:#ffffff;border-top:4px solid #008751;padding:24px">
        <p style="margin:0 0 4px;font-size:14px;color:#475569">{{ 'site.name'|trans({}, null, locale) }}</p>
        <h1 style="margin:0 0 16px;font-size:20px;color:#162233">{{ ('workflow.email.' ~ kind ~ '.title')|trans({}, null, locale) }}</h1>
        <p>{{ ('workflow.email.' ~ kind ~ '.intro')|trans({title: title}, null, locale) }}</p>
        {% if reason %}
            <p style="margin:16px 0;padding:16px;background:#f7f9fc">
                <strong style="display:block;font-size:14px;color:#475569">{{ 'workflow.history.reason'|trans({}, null, locale) }}</strong>
                {{ reason }}
            </p>
        {% endif %}
        {% if url %}<p><a href="{{ url }}" style="color:#162233">{{ 'workflow.email.open'|trans({}, null, locale) }}</a></p>{% endif %}
    </div>
</body>
</html>
