{% extends 'base.html.twig' %}

{% block title %}{{ 'data.title'|trans }} | {{ 'site.name'|trans }}{% endblock %}

{% block content %}
    <div class="container-site py-8 lg:py-12">
        <twig:Breadcrumb :items="[{label: 'breadcrumb.home'|trans, href: path('app_home')}, {label: 'data.title'|trans}]" />

        <div class="mt-6 flex flex-wrap items-start justify-between gap-4">
            <div class="max-w-3xl">
                <h1 class="type-h1 text-primary">{{ 'data.title'|trans }}</h1>
                <p class="mt-3 text-ink-muted">{{ 'data.intro'|trans }}</p>
            </div>
            {% if figures is not empty %}
                <a href="{{ path('app_data_export') }}" class="btn btn-primary" download>
                    {{ ux_icon('ri:download-2-line', {class: 'size-5'}) }}
                    {{ 'data.export'|trans }}
                    <span class="sr-only"> ({{ 'data.export_format'|trans }})</span>
                </a>
            {% endif %}
        </div>

        {% if figures is empty %}
            <twig:EmptyState class="mt-8" :title="'data.empty.title'|trans" :message="'data.empty.message'|trans" />
        {% else %}
            <p class="mt-6 text-small text-ink-muted" role="status">{{ 'data.results_count'|trans({count: figures|length}) }}</p>

            <div class="mt-4 overflow-x-auto rounded-card ring-1 ring-ink-muted/15">
                <table class="w-full min-w-[40rem] border-collapse text-left">
                    <caption class="sr-only">{{ 'data.caption'|trans }}</caption>
                    <thead class="bg-mist text-small text-ink">
                        <tr>
                            <th scope="col" class="px-4 py-3 font-semibold">{{ 'data.column.label'|trans }}</th>
                            <th scope="col" class="px-4 py-3 text-right font-semibold">{{ 'data.column.value'|trans }}</th>
                            <th scope="col" class="px-4 py-3 font-semibold">{{ 'data.column.source'|trans }}</th>
                            <th scope="col" class="px-4 py-3 font-semibold">{{ 'data.column.updated'|trans }}</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-ink-muted/15">
                        {% for figure in figures %}
                            {% set translation = figure.translate(app.locale) %}
                            <tr{% if translation.locale != app.locale %} lang="{{ translation.locale }}"{% endif %}>
                                <th scope="row" class="px-4 py-3 font-semibold text-primary">{{ translation.label }}</th>
                                <td class="px-4 py-3 text-right font-semibold text-ink">
                                    {% if figure.numericValue is not null %}
                                        {{ figure.numericValue|format_number(locale: app.locale) }}{% if translation.unit %} <span class="font-normal text-ink-muted">{{ translation.unit }}</span>{% endif %}
                                    {% else %}
                                        {{ 'stat.value_pending'|trans }}
                                    {% endif %}
                                </td>
                                <td class="px-4 py-3 text-small text-ink-muted">
                                    {% if figure.sourceUrl %}
                                        <a href="{{ figure.sourceUrl }}" class="text-primary underline underline-offset-4 hover:no-underline" rel="noopener noreferrer">{{ translation.source }}<span class="sr-only"> ({{ 'footer.external_site'|trans }})</span></a>
                                    {% else %}
                                        {{ translation.source }}
                                    {% endif %}
                                </td>
                                <td class="px-4 py-3 text-small text-ink-muted">
                                    <time datetime="{{ figure.dataDate|date('Y-m-d') }}">{{ figure.dataDate|format_date('long', locale: app.locale) }}</time>
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        {% endif %}
    </div>
{% endblock %}
