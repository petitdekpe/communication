{% extends 'admin/base.html.twig' %}

{% block title %}{{ 'admin.request.title'|trans({number: request.trackingNumber}) }}{% endblock %}

{% block content %}
    {% set service_translation = request.service.translate(app.locale) %}
    <div class="mx-auto max-w-5xl">
        <nav aria-label="{{ 'breadcrumb.label'|trans }}" class="text-small">
            <a href="{{ path('app_admin_resource_list', {resource: 'requests'}) }}" class="text-primary underline underline-offset-4 hover:no-underline">{{ 'admin.resource.requests'|trans }}</a>
        </nav>
        <h1 class="type-h1 mt-3 font-mono text-primary">{{ request.trackingNumber }}</h1>
        <p class="mt-2 text-ink-muted" lang="{{ service_translation.locale }}">{{ service_translation.title }}</p>

        <div class="mt-8 grid gap-8 lg:grid-cols-[minmax(0,1fr)_18rem] lg:items-start">
            <div class="grid gap-6">
                <twig:Admin:FormSection :title="'admin.request.data'|trans">
                    <dl class="grid gap-4 sm:grid-cols-2">
                        <div>
                            <dt class="text-small text-ink-muted">{{ 'admin.column.email'|trans }}</dt>
                            <dd class="break-all font-semibold text-ink">{{ request.email }}</dd>
                        </div>
                        {% for key, value in request.payload %}
                            <div>
                                <dt class="text-small text-ink-muted">{{ ('admin.request.field.' ~ key)|trans }}</dt>
                                <dd class="break-words font-semibold text-ink">{{ value is null or value == '' ? '–' : value }}</dd>
                            </div>
                        {% endfor %}
                        <div>
                            <dt class="text-small text-ink-muted">{{ 'admin.request.consented'|trans }}</dt>
                            <dd class="font-semibold text-ink"><time datetime="{{ request.consentedAt|date('c') }}">{{ request.consentedAt|format_datetime('medium', 'short', locale: app.locale, timezone: site_timezone) }}</time></dd>
                        </div>
                    </dl>
                </twig:Admin:FormSection>

                <twig:Admin:FormSection :title="'admin.request.attachments'|trans">
                    {% if request.attachments is empty %}
                        <p class="text-ink-muted">{{ 'admin.request.no_attachments'|trans }}</p>
                    {% else %}
                        <ul class="divide-y divide-ink-muted/15" role="list">
                            {% for file in request.attachments %}
                                <li class="flex flex-wrap items-center justify-between gap-3 py-3">
                                    <span class="min-w-0 break-all text-ink">{{ file.originalFilename }} <span class="text-small text-ink-muted">({{ file.mimeType }}, {{ (file.size / 1024)|round }} Ko)</span></span>
                                    <a href="{{ path('app_admin_request_attachment', {id: request.id, attachment: file.id}) }}" class="btn btn-outline btn-sm" download>{{ 'ui.download'|trans }}<span class="sr-only"> : {{ file.originalFilename }}</span></a>
                                </li>
                            {% endfor %}
                        </ul>
                    {% endif %}
                </twig:Admin:FormSection>
            </div>

            <aside class="rounded-card bg-white p-4 shadow-card ring-1 ring-ink-muted/15" aria-labelledby="statut-demande">
                <h2 id="statut-demande" class="type-caption text-ink-muted">{{ 'admin.column.status'|trans }}</h2>
                <p class="mt-2"><twig:Admin:StatusBadge kind="request" :status="request.status.value" /></p>
                <p class="mt-3 text-small text-ink-muted">{{ 'admin.request.received_on'|trans }}
                    <time datetime="{{ request.createdAt|date('c') }}">{{ request.createdAt|format_datetime('medium', 'short', locale: app.locale, timezone: site_timezone) }}</time></p>
                {% if canProcess %}
                    <form method="post" action="{{ path('app_admin_request_status', {id: request.id}) }}" class="mt-4 grid gap-3">
                        <input type="hidden" name="_token" value="{{ csrf_token('admin_request_status_' ~ request.id) }}">
                        <label for="nouveau-statut" class="text-small font-semibold text-ink">{{ 'admin.request.change_status'|trans }}</label>
                        <select id="nouveau-statut" name="status" class="min-h-11 rounded-pill border border-ink-muted bg-white px-4 text-ink">
                            {% for status in statuses %}
                                <option value="{{ status.value }}"{{ status == request.status ? ' selected' }}>{{ ('admin.status.request.' ~ status.value)|trans }}</option>
                            {% endfor %}
                        </select>
                        <p class="text-small text-ink-muted">{{ 'admin.request.status_mail_hint'|trans }}</p>
                        <label for="note-interne" class="text-small font-semibold text-ink">{{ 'admin.request.internal_note'|trans }}</label>
                        <textarea id="note-interne" name="note" rows="5" maxlength="5000" aria-describedby="note-interne-aide"
                                  class="rounded-card border border-ink-muted bg-white p-3 text-ink">{{ request.internalNote }}</textarea>
                        <p id="note-interne-aide" class="text-small text-ink-muted">{{ 'admin.request.internal_note_help'|trans }}</p>
                        <button type="submit" class="btn btn-primary">{{ 'admin.action.save'|trans }}</button>
                    </form>
                {% elseif request.internalNote %}
                    <h3 class="mt-4 text-small font-semibold text-ink">{{ 'admin.request.internal_note'|trans }}</h3>
                    <p class="mt-1 whitespace-pre-line text-small text-ink">{{ request.internalNote }}</p>
                {% endif %}
            </aside>
        </div>
    </div>
{% endblock %}
