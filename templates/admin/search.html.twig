{% extends 'admin/base.html.twig' %}

{% block title %}{{ 'admin.search.title'|trans }}{% endblock %}

{% block content %}
    <div class="mx-auto max-w-4xl">
        <h1 class="type-h1 text-primary">{{ 'admin.search.title'|trans }}</h1>
        {% if query is empty %}
            <p class="mt-4 text-ink-muted">{{ 'admin.search.hint'|trans }}</p>
        {% elseif groups is empty %}
            <p class="mt-4 text-ink" role="status">{{ 'admin.search.none'|trans({query: query}) }}</p>
        {% else %}
            <p class="mt-4 text-ink" role="status">{{ 'search.results_for'|trans({query: query}) }}</p>
            {% for group in groups %}
                <section class="mt-8" aria-labelledby="recherche-{{ group.resource.id }}">
                    <h2 id="recherche-{{ group.resource.id }}" class="type-h3 text-primary">
                        {{ group.resource.label|trans }} <span class="text-small font-normal text-ink-muted">({{ group.total }})</span>
                    </h2>
                    <ul class="mt-3 divide-y divide-ink-muted/15 rounded-card bg-white ring-1 ring-ink-muted/15" role="list">
                        {% for item in group.items %}
                            <li class="flex flex-wrap items-center justify-between gap-3 px-4 py-3">
                                {% if item.url %}<a href="{{ item.url }}" class="font-semibold text-primary underline underline-offset-4 hover:no-underline">{{ item.title }}</a>{% else %}<span class="font-semibold">{{ item.title }}</span>{% endif %}
                                {% if item.status %}<twig:Admin:StatusBadge kind="publication" :status="item.status" />{% endif %}
                            </li>
                        {% endfor %}
                    </ul>
                    {% if group.total > group.items|length %}
                        <p class="mt-2 text-small"><a href="{{ path('app_admin_resource_list', {resource: group.resource.id, q: query}) }}" class="text-primary underline underline-offset-4 hover:no-underline">{{ 'admin.search.see_all'|trans({count: group.total}) }}</a></p>
                    {% endif %}
                </section>
            {% endfor %}
        {% endif %}
    </div>
{% endblock %}
