<!DOCTYPE html>
<html lang="fr">
<body style="margin:0;padding:24px;background:#f7f9fc;color:#1b1b1b;font-family:Montserrat,Arial,sans-serif;line-height:1.5">
    <div style="max-width:560px;margin:0 auto;background:#ffffff;border-top:4px solid #008751;padding:24px">
        <p style="margin:0 0 4px;font-size:14px;color:#475569">{{ 'admin.site'|trans }}</p>
        <h1 style="margin:0 0 16px;font-size:20px;color:#162233">{{ 'admin.reset.mail.title'|trans }}</h1>
        <p>{{ 'admin.reset.mail.intro'|trans }}</p>
        <p style="margin:24px 0"><a href="{{ url('app_admin_reset_password', {token: resetToken.token}) }}" style="display:inline-block;padding:12px 24px;background:#162233;color:#ffffff;text-decoration:none;border-radius:999px;font-weight:bold">{{ 'admin.reset.mail.cta'|trans }}</a></p>
        <p style="font-size:14px;color:#475569">{{ 'admin.reset.mail.ignore'|trans }}</p>
    </div>
</body>
</html>
