{#
    Fenêtre « Choisir un média » pilotée par le contrôleur Stimulus media-dialog. À placer à l'intérieur de l'élément
    portant data-controller="media-dialog" et hors de tout <form> (elle contient ses propres formulaires).
#}
<dialog data-media-dialog-target="dialog" aria-labelledby="media-dialog-title"
        class="m-auto w-[min(100%-2rem,56rem)] max-h-[90vh] overflow-y-auto rounded-card bg-white p-0 text-ink shadow-raised">
    <div class="grid gap-6 p-6">
        <div class="flex items-start justify-between gap-4">
            <h2 id="media-dialog-title" class="type-h2 text-primary">{{ 'page_editor.media.title'|trans }}</h2>
            <button type="button" class="btn btn-ghost btn-icon" data-action="media-dialog#close">
                {{ ux_icon('ri:close-line', {class: 'size-5'}) }}
                <span class="sr-only">{{ 'page_editor.media.close'|trans }}</span>
            </button>
        </div>

        <form role="search" class="flex flex-col gap-2 sm:flex-row" data-action="submit->media-dialog#search">
            <label for="media-dialog-q" class="sr-only">{{ 'page_editor.media.search'|trans }}</label>
            <input id="media-dialog-q" type="search" data-media-dialog-target="search" placeholder="{{ 'page_editor.media.search'|trans }}"
                   class="min-h-11 min-w-0 flex-1 rounded-pill border border-ink-muted bg-white px-4 text-ink">
            <button type="submit" class="btn btn-primary">{{ 'page_editor.media.search_submit'|trans }}</button>
        </form>

        <div data-media-dialog-target="results" aria-live="polite"></div>

        <form data-media-dialog-target="uploadForm" data-action="submit->media-dialog#upload" enctype="multipart/form-data" class="grid gap-4 border-t border-ink-muted/30 pt-6">
            <h3 class="type-h3 text-primary">{{ 'page_editor.media.upload_title'|trans }}</h3>
            <input type="hidden" name="_token" value="{{ csrf_token('media_picker_upload') }}">
            <div class="grid gap-1">
                <label for="media-dialog-file" class="font-semibold text-ink">{{ 'page_editor.media.file'|trans }}</label>
                <input id="media-dialog-file" type="file" name="file" accept="image/jpeg,image/png,image/webp,image/gif" required aria-describedby="media-dialog-file-help"
                       class="rounded-card border border-ink-muted bg-white p-2 text-small text-ink file:mr-3 file:cursor-pointer file:rounded-pill file:border-0 file:bg-primary file:px-4 file:py-2 file:font-semibold file:text-white">
                <p id="media-dialog-file-help" class="text-small text-ink-muted">{{ 'page_editor.media.file_help'|trans }}</p>
            </div>
            <div class="grid gap-4 sm:grid-cols-2">
                <div class="grid gap-1">
                    <label for="media-dialog-alt-fr" class="font-semibold text-ink">{{ 'page_editor.media.alt_fr'|trans }}</label>
                    <input id="media-dialog-alt-fr" type="text" name="alt_fr" maxlength="255" required class="min-h-11 rounded-pill border border-ink-muted bg-white px-4 text-ink">
                </div>
                <div class="grid gap-1">
                    <label for="media-dialog-alt-en" class="font-semibold text-ink">{{ 'page_editor.media.alt_en'|trans }}</label>
                    <input id="media-dialog-alt-en" type="text" name="alt_en" maxlength="255" class="min-h-11 rounded-pill border border-ink-muted bg-white px-4 text-ink">
                </div>
            </div>
            <p data-media-dialog-target="error" role="alert" hidden class="rounded-card border border-flag-red bg-white p-3 text-small text-ink"></p>
            <div><button type="submit" class="btn btn-primary">{{ 'page_editor.media.upload_submit'|trans }}</button></div>
        </form>
    </div>
</dialog>
