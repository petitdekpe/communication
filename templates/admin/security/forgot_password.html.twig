{% extends 'admin/security/base.html.twig' %}

{% block title %}{{ 'admin.forgot.title'|trans }}{% endblock %}

{% block auth_content %}
    <h1 class="type-h2 text-primary">{{ 'admin.forgot.title'|trans }}</h1>
    <p class="mt-3 text-ink-muted">{{ 'admin.forgot.intro'|trans }}</p>
    {{ form_start(form, {attr: {novalidate: 'novalidate', class: 'mt-6 grid gap-5', 'data-turbo': 'false', 'data-controller': 'form-errors'}}) }}
        {% include 'service/_form_errors.html.twig' with {form: form} only %}
        {{ form_row(form.email) }}
        <button type="submit" class="btn btn-primary btn-lg">{{ 'admin.forgot.submit'|trans }}</button>
    {{ form_end(form) }}
    <p class="mt-6 text-small"><a href="{{ path('app_admin_login') }}" class="text-primary underline underline-offset-4 hover:no-underline">{{ 'admin.forgot.back'|trans }}</a></p>
{% endblock %}
