{% extends 'admin/security/base.html.twig' %}

{% block title %}{{ 'admin.reset.title'|trans }}{% endblock %}

{% block auth_content %}
    <h1 class="type-h2 text-primary">{{ 'admin.reset.title'|trans }}</h1>
    {{ form_start(form, {attr: {novalidate: 'novalidate', class: 'mt-6 grid gap-5', 'data-turbo': 'false', 'data-controller': 'form-errors'}}) }}
        {% include 'service/_form_errors.html.twig' with {form: form} only %}
        {{ form_row(form.plainPassword.first) }}
        {{ form_row(form.plainPassword.second) }}
        {{ form_errors(form.plainPassword) }}
        <button type="submit" class="btn btn-primary btn-lg">{{ 'admin.reset.submit'|trans }}</button>
    {{ form_end(form) }}
{% endblock %}
