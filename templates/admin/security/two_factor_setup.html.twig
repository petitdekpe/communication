{% extends 'admin/security/base.html.twig' %}

{% block title %}{{ 'admin.2fa.setup_title'|trans }}{% endblock %}

{% block auth_content %}
    <h1 class="type-h2 text-primary">{{ 'admin.2fa.setup_title'|trans }}</h1>
    <p class="mt-3 text-ink-muted">{{ 'admin.2fa.setup_intro'|trans }}</p>

    <ol class="mt-5 grid gap-3 text-small text-ink">
        <li>{{ 'admin.2fa.step_app'|trans }}</li>
        <li>
            {{ 'admin.2fa.step_key'|trans }}
            <p class="mt-2 break-all rounded-card bg-mist p-3 font-mono text-body font-bold text-primary" data-testid="totp-secret">{{ secret }}</p>
            <a href="{{ uri }}" class="mt-2 inline-block text-primary underline underline-offset-4 hover:no-underline">{{ 'admin.2fa.open_app'|trans }}</a>
        </li>
        <li>{{ 'admin.2fa.step_code'|trans }}</li>
    </ol>

    {% if error %}
        <p role="alert" class="mt-4 rounded-card border-l-4 border-flag-red bg-white p-3 text-small font-semibold text-flag-red ring-1 ring-ink-muted/20">{{ error }}</p>
    {% endif %}

    <form method="post" action="{{ path('app_admin_2fa_setup') }}" class="mt-5 grid gap-5" data-turbo="false">
        <div class="grid gap-1">
            <label for="code" class="text-small font-semibold text-ink">{{ 'admin.2fa.code'|trans }}</label>
            <input id="code" name="code" type="text" inputmode="numeric" autocomplete="one-time-code" pattern="[0-9 ]*" maxlength="7" required autofocus
                   class="min-h-11 w-full rounded-pill border border-ink-muted bg-white px-4 text-center text-h3 tracking-widest text-ink">
        </div>
        <input type="hidden" name="_token" value="{{ csrf_token('admin_2fa_setup') }}">
        <button type="submit" class="btn btn-primary btn-lg">{{ 'admin.2fa.setup_submit'|trans }}</button>
    </form>
    <p class="mt-6 text-small"><a href="{{ path('app_admin_logout') }}" class="text-primary underline underline-offset-4 hover:no-underline">{{ 'admin.logout'|trans }}</a></p>
{% endblock %}
