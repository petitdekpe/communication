{% extends 'admin/base.html.twig' %}

{% block title %}{{ 'admin.resource.translations'|trans }}{% endblock %}

{% block content %}
    <div class="mx-auto max-w-5xl">
        <h1 class="type-h1 text-primary">{{ 'admin.resource.translations'|trans }}</h1>
        <p class="mt-2 text-small text-ink-muted">{{ 'admin.translations.intro'|trans }}</p>

        <div class="mt-8 grid gap-6 md:grid-cols-2">
            <twig:Admin:FormSection :title="'admin.translations.export_title'|trans" :description="'admin.translations.export_help'|trans">
                <div>
                    <a href="{{ path('app_admin_translations_export') }}" class="btn btn-primary">
                        {{ ux_icon('ri:download-2-line', {class: 'size-5'}) }}
                        {{ 'admin.translations.export_all'|trans }}
                    </a>
                </div>
            </twig:Admin:FormSection>

            <twig:Admin:FormSection :title="'admin.translations.import_title'|trans" :description="'admin.translations.import_help'|trans">
                <form method="post" action="{{ path('app_admin_translations_import') }}" enctype="multipart/form-data" class="grid gap-3">
                    <input type="hidden" name="_token" value="{{ csrf_token('admin_translations_import') }}">
                    <label for="xliff-file" class="text-small font-semibold text-ink">{{ 'admin.translations.import_file'|trans }}</label>
                    <input id="xliff-file" type="file" name="xliff" accept=".xlf,.xliff,.xml" required class="rounded-card border border-ink-muted bg-white p-2 text-ink">
                    <div><button type="submit" class="btn btn-outline">{{ 'admin.translations.import_preview'|trans }}</button></div>
                </form>
            </twig:Admin:FormSection>
        </div>

        <h2 class="type-h2 mt-10 text-primary">{{ 'admin.translations.missing_title'|trans }}</h2>
        {% if groups is empty %}
            <div class="mt-4"><twig:Admin:EmptyState :title="'admin.translations.none'|trans" :message="'admin.translations.none_hint'|trans" /></div>
        {% else %}
            <div class="mt-4 grid gap-6">
                {% for group in groups %}
                    <section aria-labelledby="missing-{{ group.resource.id }}" class="rounded-card border border-ink-muted/30 bg-white p-6">
                        <div class="flex flex-wrap items-center justify-between gap-3">
                            <h3 id="missing-{{ group.resource.id }}" class="type-h3 text-primary">{{ group.resource.label|trans }}
                                <span class="text-small font-normal text-ink-muted">({{ 'admin.translations.count'|trans({count: group.total}) }})</span></h3>
                            <a href="{{ path('app_admin_translations_export', {resource: group.resource.id}) }}" class="btn btn-outline btn-sm">
                                {{ ux_icon('ri:download-2-line', {class: 'size-4'}) }}
                                {{ 'admin.translations.export_one'|trans }}<span class="sr-only"> : {{ group.resource.label|trans }}</span>
                            </a>
                        </div>
                        <ul class="mt-4 divide-y divide-ink-muted/15" role="list">
                            {% for item in group.items %}
                                <li class="py-2">
                                    {% if group.resource.editRoute %}
                                        <a href="{{ path(group.resource.editRoute, {id: item.id}) }}" class="text-primary underline underline-offset-4 hover:no-underline" lang="fr">{{ item.title }}</a>
                                    {% else %}
                                        <span lang="fr">{{ item.title }}</span>
                                    {% endif %}
                                </li>
                            {% endfor %}
                        </ul>
                        {% if group.total > group.items|length %}
                            <p class="mt-3 text-small text-ink-muted">{{ 'admin.translations.truncated'|trans({shown: group.items|length, total: group.total}) }}</p>
                        {% endif %}
                    </section>
                {% endfor %}
            </div>
        {% endif %}
    </div>
{% endblock %}
