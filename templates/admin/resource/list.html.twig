{% extends 'admin/base.html.twig' %}

{% block title %}{{ resource.label|trans }}{% endblock %}

{% block content %}
    <div class="mx-auto max-w-7xl">
        <div class="flex flex-wrap items-start justify-between gap-4">
            <div>
                <h1 class="type-h1 text-primary">{{ resource.label|trans }}</h1>
                <p class="mt-2 text-small text-ink-muted" role="status">{{ 'admin.table.count'|trans({count: pager.nbResults}) }}</p>
            </div>
            {% if canCreate %}
                <a href="{{ path(resource.newRoute) }}" class="btn btn-primary">
                    {{ ux_icon('ri:add-line', {class: 'size-5'}) }}
                    {{ 'admin.action.new'|trans }}
                </a>
            {% endif %}
        </div>

        {% if resource.exportable %}
            <form method="get" action="{{ path('app_admin_resource_export', {resource: resource.id}) }}" class="mt-6 flex flex-wrap items-end gap-3 rounded-card border border-ink-muted/30 bg-white p-4" aria-labelledby="export-titre">
                <h2 id="export-titre" class="type-h3 w-full text-primary">{{ 'admin.export.title'|trans }}</h2>
                <div class="grid gap-1">
                    <label for="export-from" class="text-small font-semibold text-ink">{{ 'admin.export.from'|trans }}</label>
                    <input id="export-from" name="from" type="date" class="min-h-11 rounded-pill border border-ink-muted bg-white px-4 text-ink">
                </div>
                <div class="grid gap-1">
                    <label for="export-to" class="text-small font-semibold text-ink">{{ 'admin.export.to'|trans }}</label>
                    <input id="export-to" name="to" type="date" class="min-h-11 rounded-pill border border-ink-muted bg-white px-4 text-ink">
                </div>
                <button type="submit" class="btn btn-outline">
                    {{ ux_icon('ri:download-2-line', {class: 'size-5'}) }}
                    {{ 'admin.export.submit'|trans }}
                </button>
                <p class="w-full text-small text-ink-muted">{{ 'admin.export.help'|trans }}</p>
            </form>
        {% endif %}

        <twig:Admin:FilterBar class="mt-6" :fields="filters" :values="app.request.query.all" :action="path('app_admin_resource_list', {resource: resource.id})" :hidden="app.request.query.get('sort') ? {sort: app.request.query.get('sort'), dir: app.request.query.get('dir')} : {}" />

        <div class="mt-6">
            {% if rows is empty %}
                <twig:Admin:EmptyState :title="'admin.table.empty'|trans" :message="'admin.table.empty_hint'|trans" />
            {% else %}
                <twig:Admin:DataTable
                    :id="resource.id"
                    :caption="resource.label|trans"
                    :columns="resource.columns|map(c => {key: c.key, label: c.label, sort: c.sort is defined and c.sort})"
                    :rows="rows"
                    :sort="sort"
                    :dir="dir"
                    route="app_admin_resource_list"
                    :params="{resource: resource.id}"
                    :query="app.request.query.all|filter((v, k) => k != 'page')"
                    :bulk="bulk"
                    :bulkUrl="path('app_admin_resource_bulk', {resource: resource.id})"
                    :bulkToken="bulkToken" />
                <twig:Admin:Pagination :pager="pager" route="app_admin_resource_list" :params="{resource: resource.id}" :query="app.request.query.all|filter((v, k) => k != 'page')" />
            {% endif %}
        </div>
    </div>
{% endblock %}
