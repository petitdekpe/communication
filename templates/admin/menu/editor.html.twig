{% extends 'admin/base.html.twig' %}

{% block title %}{{ 'admin.resource.menus'|trans }} : {{ ('admin.menus.name.' ~ menu)|trans }}{% endblock %}

{% macro node(node, level, maxDepth) %}
    <li data-id="{{ node.item.id }}" class="rounded-card">
        <div data-menu-tree-row class="flex flex-wrap items-center gap-2 rounded-card border border-ink-muted/30 bg-white px-3 py-2">
            <span data-menu-tree-handle class="cursor-grab touch-none text-ink-muted" aria-hidden="true">{{ ux_icon('ri:draggable', {class: 'size-5'}) }}</span>
            <div class="min-w-0 flex-1">
                <p class="font-semibold text-ink">{{ node.label }}</p>
                <p class="break-all text-small text-ink-muted">{{ node.destination ?: 'admin.menus.group'|trans }}</p>
            </div>
            <div class="flex flex-wrap items-center gap-1">
                <button type="button" class="btn btn-outline btn-sm btn-icon" data-action="menu-tree#up">{{ ux_icon('ri:arrow-up-line', {class: 'size-4'}) }}<span class="sr-only">{{ 'admin.menus.up'|trans({label: node.label}) }}</span></button>
                <button type="button" class="btn btn-outline btn-sm btn-icon" data-action="menu-tree#down">{{ ux_icon('ri:arrow-down-line', {class: 'size-4'}) }}<span class="sr-only">{{ 'admin.menus.down'|trans({label: node.label}) }}</span></button>
                {% if maxDepth > 1 %}
                    <button type="button" class="btn btn-outline btn-sm btn-icon" data-action="menu-tree#indent">{{ ux_icon('ri:indent-increase', {class: 'size-4'}) }}<span class="sr-only">{{ 'admin.menus.indent'|trans({label: node.label}) }}</span></button>
                    <button type="button" class="btn btn-outline btn-sm btn-icon" data-action="menu-tree#outdent">{{ ux_icon('ri:indent-decrease', {class: 'size-4'}) }}<span class="sr-only">{{ 'admin.menus.outdent'|trans({label: node.label}) }}</span></button>
                {% endif %}
                <a href="{{ path('app_admin_menu_item_edit', {id: node.item.id}) }}" class="btn btn-outline btn-sm">{{ 'admin.action.edit'|trans }}<span class="sr-only"> : {{ node.label }}</span></a>
                <form id="delete-item-{{ node.item.id }}" method="post" action="{{ path('app_admin_menu_item_delete', {id: node.item.id}) }}">
                    <input type="hidden" name="_token" value="{{ csrf_token('admin_menu_delete_' ~ node.item.id) }}">
                    <button type="button" class="btn btn-outline btn-sm border-flag-red text-flag-red"
                            data-action="confirm-dialog#ask" data-confirm-dialog-form-param="delete-item-{{ node.item.id }}"
                            data-confirm-dialog-message-param="{{ (node.children is empty ? 'admin.menus.confirm_delete' : 'admin.menus.confirm_delete_children')|trans({label: node.label}) }}">
                        {{ 'admin.action.delete'|trans }}<span class="sr-only"> : {{ node.label }}</span>
                    </button>
                </form>
            </div>
        </div>
        <ul data-menu-tree-list class="ml-6 grid min-h-2 gap-2 pt-2" role="list">
            {% for child in node.children %}{{ _self.node(child, level + 1, maxDepth) }}{% endfor %}
        </ul>
    </li>
{% endmacro %}

{% block content %}
    <div class="mx-auto max-w-5xl" data-controller="confirm-dialog">
        <h1 class="type-h1 text-primary">{{ 'admin.resource.menus'|trans }}</h1>
        <p class="mt-2 text-small text-ink-muted">{{ 'admin.menus.intro'|trans }}</p>

        <nav aria-label="{{ 'admin.menus.nav'|trans }}" class="mt-6">
            <ul class="flex flex-wrap gap-2" role="list">
                {% for name in menus %}
                    <li><a href="{{ path('app_admin_menu', {menu: name}) }}" class="btn btn-sm {{ name == menu ? 'btn-primary' : 'btn-outline' }}"{% if name == menu %} aria-current="page"{% endif %}>{{ ('admin.menus.name.' ~ name)|trans }}</a></li>
                {% endfor %}
            </ul>
        </nav>

        <div class="mt-6 flex flex-wrap items-center justify-between gap-3">
            <h2 class="type-h3 text-primary">{{ ('admin.menus.name.' ~ menu)|trans }}</h2>
            <a href="{{ path('app_admin_menu_item_new', {menu: menu}) }}" class="btn btn-primary">
                {{ ux_icon('ri:add-line', {class: 'size-5'}) }}
                {{ 'admin.menus.add'|trans }}
            </a>
        </div>

        {% if empty %}
            <div class="mt-6">
                <twig:Admin:EmptyState :title="'admin.menus.empty'|trans" :message="'admin.menus.empty_hint'|trans" />
                <form method="post" action="{{ path('app_admin_menu_import', {menu: menu}) }}" class="mt-4">
                    <input type="hidden" name="_token" value="{{ csrf_token('admin_menu_import_' ~ menu) }}">
                    <button type="submit" class="btn btn-outline">{{ 'admin.menus.import'|trans }}</button>
                </form>
            </div>
            {# Liste vide : le glisser-déposer n'est pas nécessaire tant qu'aucune entrée n'existe. #}
        {% else %}
            <p class="mt-4 text-small text-ink-muted">{{ 'admin.menus.keyboard_hint'|trans }}</p>
            <div class="mt-4"
                 data-controller="menu-tree"
                 data-menu-tree-url-value="{{ path('app_admin_menu_reorder', {menu: menu}) }}"
                 data-menu-tree-token-value="{{ csrf_token('admin_menu_order') }}"
                 data-menu-tree-max-depth-value="{{ maxDepth }}"
                 data-menu-tree-saved-value="{{ 'admin.menus.saved'|trans }}"
                 data-menu-tree-error-value="{{ 'admin.menus.save_error'|trans }}">
                <p class="sr-only" role="status" aria-live="polite" data-menu-tree-target="status"></p>
                <ul data-menu-tree-list class="grid gap-2" role="list">
                    {% for node in tree %}{{ _self.node(node, 1, maxDepth) }}{% endfor %}
                </ul>
            </div>
        {% endif %}

        <twig:Admin:ConfirmDialog />
    </div>
{% endblock %}
