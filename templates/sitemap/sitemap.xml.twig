<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9" xmlns:xhtml="http://www.w3.org/1999/xhtml">
{% for entry in entries %}
    <url>
        <loc>{{ entry.loc }}</loc>
{% if entry.lastmod %}
        <lastmod>{{ entry.lastmod|date('Y-m-d') }}</lastmod>
{% endif %}
{% for locale, href in entry.alternates %}
        <xhtml:link rel="alternate" hreflang="{{ locale }}" href="{{ href }}"/>
{% endfor %}
{% if entry.alternates[default_locale] is defined %}
        <xhtml:link rel="alternate" hreflang="x-default" href="{{ entry.alternates[default_locale] }}"/>
{% endif %}
    </url>
{% endfor %}
</urlset>
