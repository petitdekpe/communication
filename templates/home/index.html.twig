{% extends 'base.html.twig' %}

{#
    Page d'accueil : chaque bloc est alimenté par la base de données.
      - articles, documents, événements, démarches, chiffres clés, consultations : contenus publiés ;
      - avis officiel, ouverture, lettre d'information : paramètres du site (HomeSettings) ;
      - intitulés de rubrique, accès directs, espace presse : chaînes d'interface (traductions).
    Un bloc sans contenu n'est pas affiché ; l'avis officiel, l'ouverture et la lettre d'information s'appuient sur des valeurs par défaut.
#}

{% block content %}
    {# 1. Avis officiel (paramètre « home.notice.message », vide = pas d'avis) ----------- #}
    {% set notice_message = settings.get('home.notice.message', locale) %}
    {% if notice_message and settings.noticeIsActive(now) %}
        <twig:OfficialNotice
            :id="'accueil-' ~ (settings.updatedAt('home.notice.message')|date('YmdHis'))"
            :message="notice_message"
            :href="settings.get('home.notice.href', locale)" />
    {% endif %}

    {# 2. Ouverture : titre, chapô, boutons ------------------ #}
    {% set hero_card = featured ?: null %}
    <section class="bg-cream/40" aria-labelledby="titre-accueil">
        <div class="container-site grid grid-cols-1 items-center gap-10 py-12 lg:py-16 {{ hero_card ? 'lg:grid-cols-[minmax(0,1.15fr)_minmax(0,1fr)] lg:gap-16' : '' }}">
        <div class="min-w-0">
            <h1 id="titre-accueil" class="font-sans text-[2.5rem] leading-[1.1] font-extrabold tracking-tight text-primary sm:text-6xl">{{ (settings.get('home.hero.title', locale) ?? ('site.name'|trans))|replace({"
": "
"})|replace({"
": '<br>'})|sanitize_html('app.home_text') }}</h1>
            {% set hero_lead = settings.get('home.hero.lead', locale) %}
            {% if hero_lead %}
                <p class="mt-6 max-w-prose text-body text-ink-muted lg:text-h3 lg:font-normal">{{ hero_lead|replace({"
": "
"})|replace({"
": '<br>'})|sanitize_html('app.home_text') }}</p>
            {% endif %}

            <p class="mt-8 flex flex-wrap gap-3">
                <twig:Button :label="'home.hero.discover'|trans" :href="path('app_page_show', {path: 'home.paths.ministry'|trans})" size="lg" icon="ri:arrow-right-line" iconPosition="end" />
                <twig:Button :label="'home.hero.projects'|trans" :href="path('app_page_show', {path: 'home.paths.projects'|trans})" variant="secondary" size="lg" />
            </p>
        </div>

        {# Carte « à la une » : l'article mis en avant, titre en surimpression sur dégradé bleu nuit (texte blanc AA). #}
        {% if hero_card %}
            {% set card_translation = hero_card.translate(app.locale) %}
            {% set card_cover = hero_card.coverImage %}
            <article class="group relative min-w-0 overflow-hidden rounded-[1.5rem] bg-white p-3 shadow-raised ring-1 ring-ink-muted/15"{% if card_translation.locale != app.locale %} lang="{{ card_translation.locale }}"{% endif %}>
                <div class="relative aspect-[4/3] overflow-hidden rounded-card bg-primary">
                    {% if card_cover %}
                        <img src="{{ media_url(card_cover) }}" alt="{{ media_alt(card_cover) }}" width="960" height="720" class="size-full object-cover">
                    {% endif %}
                    <div class="absolute inset-0 bg-gradient-to-t from-primary via-primary/60 to-transparent" aria-hidden="true"></div>
                    {% if hero_card.type.category %}
                        <span class="badge absolute top-4 left-4 bg-white text-primary">{{ hero_card.type.category.labelKey|trans }}</span>
                    {% endif %}
                    <div class="absolute inset-x-0 bottom-0 p-5 text-white">
                        <time datetime="{{ hero_card.publishedAt|date('Y-m-d') }}" class="text-small text-white/90">{{ hero_card.publishedAt|format_date('long', locale: app.locale) }}</time>
                        <h2 class="mt-1 font-sans text-h3 font-bold text-white">{{ card_translation.title }}</h2>
                    </div>
                </div>
                <div class="px-3 pt-4 pb-2">
                    {% if card_translation.excerpt %}
                        <p class="line-clamp-2 text-small text-ink-muted">{{ card_translation.excerpt }}</p>
                    {% endif %}
                    <p class="mt-4 border-t border-ink-muted/20 pt-3 text-right">
                        <a href="{{ article_url(hero_card) }}" class="type-caption inline-flex items-center gap-2 text-primary after:absolute after:inset-0">
                            {{ 'home.hero.read'|trans }}
                            {{ ux_icon('ri:arrow-right-line', {class: 'size-4'}) }}
                        </a>
                    </p>
                </div>
            </article>
        {% endif %}
        </div>
    </section>

    {# 2 bis. Notre cap, priorités et projets (chaînes d'interface : textes officiels du document éditorial) #}
    <section class="py-16 lg:py-20" aria-labelledby="notre-cap">
        <div class="container-site grid gap-8 lg:grid-cols-12 lg:gap-12">
            <div class="lg:col-span-5">
                <twig:SectionHeading id="notre-cap" :kicker="'home.cap.kicker'|trans" :title="'home.cap.title'|trans" />
            </div>
            <div class="space-y-4 text-ink lg:col-span-7">
                {% for key in ['p1', 'p2', 'p3', 'p4'] %}<p>{{ ('home.cap.' ~ key)|trans }}</p>{% endfor %}
                <p class="pt-2">
                    <twig:Button :label="'home.cap.cta'|trans" :href="path('app_page_show', {path: 'home.paths.ministry'|trans}) ~ '#nos-priorites'" variant="secondary" icon="ri:arrow-right-line" iconPosition="end" />
                </p>
            </div>
        </div>
    </section>

    <section class="py-16 lg:py-20" aria-labelledby="nos-projets">
        <div class="container-site grid gap-8 lg:grid-cols-12 lg:gap-12">
            <div class="lg:col-span-5">
                <twig:SectionHeading id="nos-projets" :kicker="'home.projects.kicker'|trans" :title="'home.projects.title'|trans" />
                <p class="mt-4 text-ink-muted">{{ 'home.projects.intro'|trans }}</p>
                <p class="mt-6">
                    <twig:Button :label="'home.projects.cta'|trans" :href="path('app_page_show', {path: 'home.paths.projects'|trans})" icon="ri:arrow-right-line" iconPosition="end" />
                </p>
            </div>
            <ul class="list-disc space-y-2 pl-5 text-ink marker:text-flag-green lg:col-span-7">
                {% for number in 1..5 %}<li>{{ ('home.projects.items.' ~ number)|trans }}</li>{% endfor %}
            </ul>
        </div>
    </section>

    {# 3. À la une + communiqués récents (articles publiés, depuis la base) ------- #}
    {% if (featured and not hero_card) or releases is not empty %}
        <section class="py-16 lg:py-20">
            <div class="container-site grid gap-12 lg:grid-cols-12 lg:gap-10">
                {% if featured and not hero_card %}
                    <div class="lg:col-span-7" role="region" aria-labelledby="a-la-une">
                        <twig:SectionHeading id="a-la-une" :title="'home.featured.title'|trans" />
                        <twig:ArticleTeaser class="mt-6" :article="featured" :featured="true" />
                    </div>
                {% endif %}

                {% if releases is not empty %}
                    <div class="{{ featured and not hero_card ? 'lg:col-span-5' : 'lg:col-span-12' }}" role="region" aria-labelledby="communiques">
                        <twig:SectionHeading id="communiques" :title="'home.press_releases.title'|trans" :href="path('app_press_releases')" :linkLabel="'home.press_releases.see_all'|trans" />
                        <ol class="mt-6 divide-y divide-ink-muted/20 rounded-card bg-mist px-6">
                            {% for release in releases %}
                                {% set release_translation = release.translate(app.locale) %}
                                <li class="group relative flex flex-col py-6"{% if release_translation.locale != app.locale %} lang="{{ release_translation.locale }}"{% endif %}>
                                    <h3 class="font-semibold text-ink">
                                        <a href="{{ article_url(release) }}" class="underline-offset-4 group-hover:underline after:absolute after:inset-0">{{ release_translation.title }}</a>
                                    </h3>
                                    <div class="order-first mb-2 flex flex-wrap items-center gap-3">
                                        <twig:Badge value="communique" />
                                        <time datetime="{{ release.publishedAt|date('Y-m-d') }}" class="text-small text-ink-muted">{{ release.publishedAt|format_date('long', locale: app.locale) }}</time>
                                    </div>
                                </li>
                            {% endfor %}
                        </ol>
                    </div>
                {% endif %}
            </div>
        </section>
    {% endif %}

    {# 4. Services prioritaires ------------------------------------------------- #}
    {% if services is not empty %}
        <section class="bg-mist py-16 lg:py-20" aria-labelledby="services-prioritaires">
            <div class="container-site">
                <twig:SectionHeading id="services-prioritaires"
                    :kicker="'home.services.kicker'|trans"
                    :title="'home.services.title'|trans" />
                <div class="mt-8 grid gap-6 sm:grid-cols-2 xl:grid-cols-4">
                    {% for service in services %}
                        {% set service_translation = service.translate(locale) %}
                        <div{% if service_translation.locale != locale %} lang="{{ service_translation.locale }}"{% endif %} class="flex">
                            <twig:ServiceCard class="w-full"
                                :audience="service.audience"
                                :title="service_translation.title ?? ''"
                                :summary="service_translation.summary ?? ('ui.not_specified'|trans)"
                                :cost="service_translation.cost"
                                :delay="service_translation.delay"
                                :online="service.online"
                                :href="path('app_service_show', {slug: service_translation.slug})" />
                        </div>
                    {% endfor %}
                </div>
                <div class="mt-10 flex justify-center">
                    <twig:Button :label="'home.services.see_all'|trans" :href="path('app_services_index')" size="lg" icon="ri:arrow-right-line" iconPosition="end" />
                </div>
            </div>
        </section>
    {% endif %}

    {# 5. Actualités (3 dernières, depuis la base) --------------------------------- #}
    {% if news is not empty %}
        <section class="py-16 lg:py-20" aria-labelledby="actualites">
            <div class="container-site">
                <twig:SectionHeading id="actualites"
                    :kicker="'home.news.kicker'|trans"
                    :title="'home.news.title'|trans"
                    :href="path('app_news_index')"
                    :linkLabel="'home.news.see_all'|trans" />
                <p class="mt-4 max-w-3xl text-ink-muted">{{ 'home.news.lead'|trans }}</p>
                <div class="mt-8 grid gap-6 md:grid-cols-3">
                    {% for article in news %}
                        <twig:ArticleTeaser :article="article" />
                    {% endfor %}
                </div>
            </div>
        </section>
    {% endif %}

    {# 6. Documents officiels + agenda, côte à côte (depuis la base) ------------------- #}
    <section class="bg-mist py-16 lg:py-20">
        <div class="container-site grid gap-12 {{ agenda_enabled ? 'lg:grid-cols-2 lg:gap-16' : '' }}">
            <div role="region" aria-labelledby="documents-officiels">
                <twig:SectionHeading id="documents-officiels"
                    :title="'home.documents.title'|trans"
                    :href="path('app_documents')"
                    :linkLabel="'home.documents.see_all'|trans" />
                <p class="mt-4 text-ink-muted">{{ 'home.documents.lead'|trans }}</p>
                {% if documents is empty %}
                    <p class="mt-6 text-ink-muted">{{ 'home.documents.empty'|trans }}</p>
                {% else %}
                    <div class="mt-6 border-t border-ink-muted/20">
                        {% for document in documents %}
                            {% set document_translation = document.translate(app.locale) %}
                            {% set file = document.file %}
                            <div{% if document_translation.locale != app.locale %} lang="{{ document_translation.locale }}"{% endif %}>
                                <twig:DocumentRow
                                    :title="document_translation.title ?? ''"
                                    :fileType="enum_file_type(file.mimeType)"
                                    :size="file.size ?? 0"
                                    :date="document.documentDate ?? document.publishedAt"
                                    :href="path('app_document_download', {id: document.id})" />
                            </div>
                        {% endfor %}
                    </div>
                {% endif %}
            </div>

            {% if agenda_enabled %}
            <div role="region" aria-labelledby="agenda">
                <twig:SectionHeading id="agenda"
                    :title="'home.agenda.title'|trans"
                    :href="path('app_agenda')"
                    :linkLabel="'home.agenda.see_all'|trans" />
                {% if events is empty %}
                    <p class="mt-6 text-ink-muted">{{ 'home.agenda.empty'|trans }}</p>
                {% else %}
                    <ul class="mt-6 space-y-6">
                        {% for event in events %}
                            {% set event_translation = event.translate(app.locale) %}
                            <li{% if event_translation.locale != app.locale %} lang="{{ event_translation.locale }}"{% endif %}>
                                <twig:AgendaItem
                                    :date="event.startsAt"
                                    :title="event_translation.title ?? ''"
                                    :location="event_translation.location"
                                    :meta="event_meta(event)"
                                    :href="path('app_event_show', {slug: event_translation.slug})" />
                            </li>
                        {% endfor %}
                    </ul>
                {% endif %}
            </div>
            {% endif %}
        </div>
    </section>
    {# 7. Chiffres clés ----------------------------------------------------------- #}
    {% if figures is not empty %}
        <section class="py-16 lg:py-20" aria-labelledby="chiffres-cles">
            <div class="container-site">
                <twig:SectionHeading id="chiffres-cles"
                    :kicker="'home.stats.kicker'|trans"
                    :title="'home.stats.title'|trans"
                    :href="path('app_data')"
                    :linkLabel="'home.stats.see_all'|trans" />
                <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
                    {% for figure in figures %}
                        {% set figure_translation = figure.translate(locale) %}
                        <div{% if figure_translation.locale != locale %} lang="{{ figure_translation.locale }}"{% endif %} class="flex">
                            <twig:StatCard class="w-full"
                                :value="figure.numericValue ?? ('stat.value_pending'|trans)"
                                :label="figure_translation.label ?? ''"
                                :unit="figure_translation.unit"
                                :source="figure_translation.source ?? ''"
                                :sourceUrl="figure.sourceUrl"
                                :updatedAt="figure.dataDate" />
                        </div>
                    {% endfor %}
                </div>
            </div>
        </section>
    {% endif %}

    {# 8. Consultation citoyenne mise en avant : bloc crème, deux boutons ----------- #}
    {% if consultation %}
        {% set consultation_translation = consultation.translate(locale) %}
        <twig:Hero
            :kicker="'home.consultation.kicker'|trans"
            :title="consultation_translation.title ?? ''"
            :lead="consultation_translation.summary"
            :primaryLabel="(consultation.open(now) ? 'home.consultation.participate' : 'home.consultation.see')|trans"
            :primaryHref="path('app_consultation_show', {slug: consultation_translation.slug})"
            :secondaryLabel="'home.consultation.all'|trans"
            :secondaryHref="path('app_consultations')"
            :headingLevel="2" />
    {% endif %}

    {# 8 bis. Comprendre les médias ------------------------------------------------- #}
    <section class="bg-cream py-16 lg:py-20" aria-labelledby="comprendre-les-medias">
        <div class="container-site grid items-center gap-8 lg:grid-cols-12 lg:gap-12">
            <div class="lg:col-span-5">
                <twig:SectionHeading id="comprendre-les-medias" :kicker="'home.understand.kicker'|trans" :title="'home.understand.title'|trans" />
            </div>
            <div class="lg:col-span-7">
                <p class="text-ink">{{ 'home.understand.text'|trans }}</p>
                <p class="mt-6">
                    <twig:Button :label="'home.understand.cta'|trans" :href="path('app_page_show', {path: 'home.paths.understand'|trans})" icon="ri:arrow-right-line" iconPosition="end" />
                </p>
            </div>
        </div>
    </section>

    {# 9. Espace médias ------------------------------------------------------------ #}
    <section class="py-16 lg:py-20" aria-labelledby="espace-presse">
        <div class="container-site">
            <twig:SectionHeading id="espace-presse"
                :kicker="'home.press.kicker'|trans"
                :title="'home.press.title'|trans"
                :href="path('app_page_show', {path: 'home.paths.media_room'|trans})"
                :linkLabel="'home.press.see_all'|trans" />
            <p class="mt-4 max-w-3xl text-ink-muted">{{ 'home.press.lead'|trans }}</p>
            <div class="mt-8 grid gap-6 md:grid-cols-3">
                {% for key, item in {
                    accreditation: {icon: 'ri:id-card-line', href: path('app_services_index', {public: 'journalistes'})},
                    media_library: {icon: 'ri:gallery-line', href: path('app_media_library')},
                    press_releases: {icon: 'ri:newspaper-line', href: path('app_press_releases')},
                } %}
                    {% set item_title = ('home.press.cards.' ~ key ~ '.title')|trans %}
                    <article class="flex flex-col gap-4 rounded-card bg-white p-6 shadow-card ring-1 ring-ink-muted/15">
                        <span class="flex size-12 items-center justify-center rounded-pill bg-cream text-primary" aria-hidden="true">
                            {{ ux_icon(item.icon, {class: 'size-6'}) }}
                        </span>
                        <h3 class="type-h3 text-primary">{{ item_title }}</h3>
                        <p class="text-small text-ink-muted">{{ ('home.press.cards.' ~ key ~ '.text')|trans }}</p>
                        <div class="mt-auto">
                            <a href="{{ item.href }}" class="btn btn-outline btn-sm">
                                {{ 'home.press.open'|trans }}<span class="sr-only"> : {{ item_title }}</span>
                                {{ ux_icon('ri:arrow-right-line', {class: 'size-4'}) }}
                            </a>
                        </div>
                    </article>
                {% endfor %}
            </div>
        </div>
    </section>

    {# 9 bis. Médiathèque ---------------------------------------------------------- #}
    <section class="py-16 lg:py-20" aria-labelledby="mediatheque">
        <div class="container-site">
            <twig:SectionHeading id="mediatheque"
                :kicker="'home.library.kicker'|trans"
                :title="'home.library.title'|trans"
                :href="path('app_media_library')"
                :linkLabel="'home.library.cta'|trans" />
            <p class="mt-4 max-w-3xl text-ink-muted">{{ 'home.library.text'|trans }}</p>
        </div>
    </section>

    {# 10. Lettre d'information (formulaire non branché) ---------------------------- #}
    <section class="bg-cream py-16 lg:py-20" aria-labelledby="lettre-information">
        <div class="container-site grid items-center gap-8 lg:grid-cols-2 lg:gap-16">
            <div>
                <h2 id="lettre-information" class="type-h2 flex items-center gap-3 text-primary">
                    {{ ux_icon('ri:mail-line', {class: 'size-8 shrink-0'}) }}
                    {{ 'home.newsletter.title'|trans }}
                </h2>
                <p class="mt-3 text-ink">{{ (settings.get('home.newsletter.text', locale) ?? ('home.newsletter.default_text'|trans))|replace({"
": "
"})|replace({"
": '<br>'})|sanitize_html('app.home_text') }}</p>
            </div>

            {# Inscription avec double opt-in : l'adresse est confirmée par un lien envoyé par e-mail (voir NewsletterController). #}
            <form action="{{ path('app_newsletter') }}" method="post" data-turbo="false" novalidate>
                <label for="lettre-email" class="block text-small font-semibold text-ink">{{ 'home.newsletter.label'|trans }}</label>
                <p id="lettre-aide" class="mt-1 text-small text-ink-muted">{{ 'home.newsletter.hint'|trans }}</p>
                <div class="mt-3 flex flex-col gap-3 sm:flex-row">
                    <input id="lettre-email" name="newsletter[email]" type="email" autocomplete="email" required maxlength="180" aria-describedby="lettre-aide lettre-consentement"
                           class="min-w-0 flex-1 rounded-pill border border-ink-muted bg-white px-5 py-3 text-ink">
                    <twig:Button type="submit" :label="'home.newsletter.submit'|trans" variant="accent" size="lg" />
                </div>
                {# Piège à robots : hors écran et inerte. #}
                <div class="absolute -left-[9999px] h-px w-px overflow-hidden" inert>
                    <label for="lettre-website">{{ 'request.honeypot.label'|trans }}</label>
                    <input id="lettre-website" name="newsletter[website]" type="text" tabindex="-1" autocomplete="off">
                </div>
                {{ form_widget(newsletterForm._token) }}
                <p id="lettre-consentement" class="mt-3 text-small text-ink-muted">{{ (settings.get('newsletter.consent', locale) ?? ('home.newsletter.default_consent'|trans))|replace({"
": "
"})|replace({"
": '<br>'})|sanitize_html('app.home_text') }}</p>
            </form>
        </div>
    </section>
{% endblock %}
