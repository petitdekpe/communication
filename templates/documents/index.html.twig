{% extends 'base.html.twig' %}

{% block title %}{{ 'documents.title'|trans }} | {{ 'site.name'|trans }}{% endblock %}

{% block content %}
    <div class="container-site py-8 lg:py-12">
        <twig:Breadcrumb :items="[{label: 'breadcrumb.home'|trans, href: path('app_home')}, {label: 'documents.title'|trans}]" />

        <h1 class="type-h1 mt-6 text-primary">{{ 'documents.title'|trans }}</h1>
        <p class="mt-3 max-w-3xl text-ink-muted">{{ 'documents.intro'|trans }}</p>

        <div class="mt-8">
            {% include 'documents/_list.html.twig' with {listing: listing, types: types} only %}
        </div>
    </div>
{% endblock %}
