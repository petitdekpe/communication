{% props title, message = null, icon = 'ri:inbox-line' %}
<div{{ attributes.defaults({class: 'flex flex-col items-center rounded-card bg-mist px-6 py-12 text-center'}) }}>
    <span class="flex size-14 items-center justify-center rounded-pill bg-white text-primary shadow-card" aria-hidden="true">
        {{ ux_icon(icon, {class: 'size-7'}) }}
    </span>
    <p class="type-h3 mt-4 text-primary">{{ title }}</p>
    {% if message %}<p class="mt-2 max-w-prose text-ink-muted">{{ message }}</p>{% endif %}
    {% block content %}{% endblock %}
</div>
