{#
    Boîte de confirmation (<dialog> HTML natif : focus piégé, Échap pour annuler, focus rendu au déclencheur).
    Un déclencheur est n'importe quel bouton portant data-action="confirm-dialog#ask" et
    data-confirm-dialog-form-param="<id du formulaire à envoyer>" (+ data-confirm-dialog-message-param).
    À placer dans un élément portant data-controller="confirm-dialog".
#}
<dialog data-confirm-dialog-target="dialog" aria-labelledby="confirm-title" aria-describedby="confirm-message"
        class="m-auto w-[min(28rem,calc(100%-2rem))] rounded-card bg-white p-0 text-ink shadow-raised">
    <div class="p-6">
        <h2 id="confirm-title" class="type-h3 text-primary">{{ 'admin.confirm.title'|trans }}</h2>
        <p id="confirm-message" class="mt-3" data-confirm-dialog-target="message">{{ 'admin.confirm.default'|trans }}</p>
    </div>
    <div class="flex justify-end gap-3 border-t border-ink-muted/20 p-4">
        <button type="button" class="btn btn-outline" data-action="confirm-dialog#cancel" data-confirm-dialog-target="cancel">{{ 'admin.confirm.cancel'|trans }}</button>
        <button type="button" class="btn btn-primary" data-action="confirm-dialog#confirm">{{ 'admin.confirm.confirm'|trans }}</button>
    </div>
</dialog>
