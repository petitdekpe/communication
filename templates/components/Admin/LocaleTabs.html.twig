{#
    Onglets de langue FR / EN d'un formulaire, avec indicateur de complétude (champs renseignés / champs attendus).
    Motif « onglets » WAI-ARIA : flèches gauche/droite, Début/Fin, un seul onglet dans l'ordre de tabulation.
    Les deux panneaux restent dans le formulaire (même masqués) : tout est envoyé en un seul POST.

    <twig:Admin:LocaleTabs :tabs="[{locale: 'fr', complete: 2, total: 3}, {locale: 'en', complete: 0, total: 3}]" active="fr">
        <twig:block name="fr">…champs FR…</twig:block>
        <twig:block name="en">…champs EN…</twig:block>
    </twig:Admin:LocaleTabs>
#}
{% props tabs, active = 'fr' %}
<div{{ attributes.defaults({class: 'rounded-card border border-ink-muted/30 bg-white'}) }} data-controller="tabs">
    <div role="tablist" aria-label="{{ 'admin.locale_tabs.label'|trans }}" class="flex gap-1 border-b border-ink-muted/30 px-4 pt-3">
        {% for tab in tabs %}
            {% set selected = tab.locale == active %}
            {% set done = tab.total > 0 and tab.complete >= tab.total %}
            <button type="button" role="tab" id="tab-{{ tab.locale }}" aria-controls="panel-{{ tab.locale }}"
                    aria-selected="{{ selected ? 'true' : 'false' }}" tabindex="{{ selected ? '0' : '-1' }}"
                    data-tabs-target="tab" data-locale="{{ tab.locale }}" data-action="click->tabs#select keydown->tabs#keydown"
                    class="inline-flex items-center gap-2 rounded-t-card border-x border-t px-4 py-2 text-small font-semibold {{ selected ? 'border-ink-muted/30 bg-white text-primary' : 'border-transparent bg-mist text-ink-muted' }} aria-selected:bg-white">
                {{ ('language.' ~ tab.locale)|trans }}
                <span class="inline-flex items-center gap-1 rounded-pill px-2 text-caption {{ done ? 'bg-flag-green text-white' : 'bg-flag-yellow text-primary' }}">
                    {{ ux_icon(done ? 'ri:check-line' : 'ri:edit-line', {class: 'size-3'}) }}
                    <span>{{ tab.complete }}/{{ tab.total }}</span>
                    <span class="sr-only">{{ done ? 'admin.locale_tabs.complete'|trans : 'admin.locale_tabs.incomplete'|trans }}</span>
                </span>
            </button>
        {% endfor %}
    </div>
    {% for tab in tabs %}
        <div role="tabpanel" id="panel-{{ tab.locale }}" aria-labelledby="tab-{{ tab.locale }}" tabindex="0" lang="{{ tab.locale }}"
             data-tabs-target="panel" data-locale="{{ tab.locale }}" class="grid gap-6 p-6"{{ tab.locale != active ? ' hidden' }}>
            {% if tab.locale == 'fr' %}{% block fr %}{% endblock %}{% else %}{% block en %}{% endblock %}{% endif %}
        </div>
    {% endfor %}
</div>
