{# Modale de recherche (<dialog> natif). Ouverte par le bouton « Rechercher », le lien d'évitement ou Ctrl/Cmd+K. #}
<dialog id="recherche"
        aria-labelledby="recherche-titre"
        class="mx-auto mt-16 w-full max-w-[min(42rem,calc(100%-2rem))] rounded-card bg-white p-0 text-ink shadow-raised lg:mt-32"
        data-search-dialog-target="dialog"
        data-action="close->search-dialog#onClose click->search-dialog#backdropClick">
    <form action="{{ path('app_search') }}" method="get" role="search" class="p-6 lg:p-8">
        <div class="flex items-start justify-between gap-4">
            <h2 id="recherche-titre" class="type-h3 text-primary">{{ 'search.dialog_title'|trans }}</h2>
            <button type="button" class="btn btn-outline btn-icon" data-action="search-dialog#close">
                {{ ux_icon('ri:close-line', {class: 'size-5'}) }}
                <span class="sr-only">{{ 'search.close'|trans }}</span>
            </button>
        </div>

        <label for="recherche-q" class="mt-4 block text-small font-semibold">{{ 'search.label'|trans }}</label>
        <div class="mt-2 flex gap-2">
            <input id="recherche-q"
                   name="q"
                   type="search"
                   autocomplete="off"
                   class="min-w-0 flex-1 rounded-pill border border-ink-muted bg-white px-5 py-2.5 text-ink"
                   data-search-dialog-target="input">
            <button type="submit" class="btn btn-primary btn-icon sm:px-5">
                {{ ux_icon('ri:search-line', {class: 'size-5'}) }}
                <span class="sr-only sm:not-sr-only">{{ 'search.submit'|trans }}</span>
            </button>
        </div>
        <p class="mt-3 text-small text-ink-muted">{{ 'search.shortcut_hint'|trans }}</p>
    </form>
</dialog>
