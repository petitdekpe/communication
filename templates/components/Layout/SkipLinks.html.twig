{# Liens d'évitement : premiers éléments atteints au clavier, visibles uniquement au focus. #}
<nav aria-label="{{ 'a11y.skip_links_label'|trans }}">
    <ul>
        <li>
            <a href="#contenu" data-turbo="false" class="btn btn-primary sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-[100]">
                {{ 'a11y.skip_to_content'|trans }}
            </a>
        </li>
        <li>
            <a href="#recherche" data-turbo="false" data-action="search-dialog#open:prevent" class="btn btn-primary sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-[100]">
                {{ 'a11y.skip_to_search'|trans }}
            </a>
        </li>
    </ul>
</nav>
